// MARK: - DingTalk A1 credential import (2026-10-18)
"a1.title" = "DingTalk A1";
"a1.intro" = "Every DingTalk A1 has its own device secret. DingTalk issues it when the card is bound to an account; it can't be derived from the serial number and it is never sent over Bluetooth. So the first time, it has to be taken out of one signed-in DingTalk session — after that, listing, downloading and transcribing all happen offline, with no DingTalk involved.";
"a1.step1.title" = "Bind the card to your DingTalk account";
"a1.step1.body" = "Bought it second-hand? Ask the seller to unbind it first, then scan the code in DingTalk to bind it yourself. Only you can do this step — it decides which account the card hands its secret to.";
"a1.step2.title" = "Open “AI Notes” once on the desktop app";
"a1.step2.body" = "Any template will do. DingTalk writes the device list — secret included — into its own log on that computer.";
"a1.step3.title" = "Run one command on that Mac";
"a1.step3.body" = "It turns the secret into one line of text, copies it to the clipboard and shows a QR code — scan it or paste it. If your copy of the script lives somewhere else, edit the command below.";
"a1.copy_command" = "Copy the command";
"a1.command_footer" = "The extractor only reads DingTalk's log on this Mac. It doesn't touch the card, the firmware or your DingTalk account.";
"a1.command.editor_title" = "Extractor command";
"a1.command.editor_footer" = "The script ships with the Nomily tool package; point this at wherever it lives on your Mac. Add --qr to also draw a QR code the phone can scan — no clipboard involved. Example: cd <script dir> && python3 extract_secret_from_dingtalk_mac.py --copy --qr";
"a1.open_import" = "Import this card's key";
"a1.error.no_credential" = "This card has no key on this phone yet. Open this card's info page → “Card key” to scan or paste it — a one-time step, after which everything runs offline.";
"a1.error.rejected" = "The card rejected the stored credential (501). Each card's secret works only on that card — import this card's own credential in Settings → DingTalk A1.";
"a1.error.not_authenticated" = "The card says this session isn't authenticated (405). Disconnect and reconnect the card, then try again.";
"a1.error.bad_secret" = "The stored credential's secret is too short to produce a token. Re-import it in Settings → DingTalk A1.";
"a1.paste.section" = "Paste the credential";
